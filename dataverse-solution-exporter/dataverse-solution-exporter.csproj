<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>dataverse_solution_exporter</RootNamespace>
    <AssemblyName>DataverseSolutionExporter</AssemblyName>
    <AssemblyTitle>Dataverse Solution Exporter</AssemblyTitle>
    <Product>Dataverse Solution Exporter</Product>
    <Description>Publish and export verified unmanaged Dataverse solutions and inspect included table metadata and records.</Description>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.PowerPlatform.Dataverse.Client" Version="1.2.26" />
  </ItemGroup>

</Project>
